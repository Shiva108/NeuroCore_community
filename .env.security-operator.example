# Local security-operator defaults for NeuroCore.
# Use `python scripts/bootstrap.py` to create a working .env automatically.
# Never commit real credentials, production URLs, or operator-specific values.
# This is the default operator profile: local SQLite plus full mirrored Supabase
# Postgres for both primary and sealed data. If one backend write fails, the
# surviving copy remains available and the runtime reports degraded mirror state.

NEUROCORE_OPERATOR_HOME=~/.local/state/neurocore
NEUROCORE_DEFAULT_NAMESPACE=security-lab
NEUROCORE_ALLOWED_BUCKETS=recon,targets,findings,payloads,reports,agents,ops
NEUROCORE_DEFAULT_SENSITIVITY=restricted
NEUROCORE_STORAGE_BACKEND=mirror
NEUROCORE_MIRROR_READ_PREFERENCE=local
NEUROCORE_MIRROR_SEALED_MODE=full
NEUROCORE_PRIMARY_STORE_PATH=${NEUROCORE_OPERATOR_HOME}/data/neurocore.db
NEUROCORE_SEALED_STORE_PATH=${NEUROCORE_OPERATOR_HOME}/data/neurocore-sealed.db
NEUROCORE_SEMANTIC_BACKEND=sentence-transformers
NEUROCORE_SEMANTIC_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
NEUROCORE_MAX_ATOMIC_TOKENS=350
NEUROCORE_TARGET_CHUNK_TOKENS=600
NEUROCORE_MAX_CHUNK_TOKENS=900
NEUROCORE_CHUNK_OVERLAP_TOKENS=75
NEUROCORE_MAX_CONTENT_TOKENS=50000
NEUROCORE_DEFAULT_TOP_K=8
NEUROCORE_ALLOW_HARD_DELETE=false
NEUROCORE_ENABLE_ADMIN_SURFACE=true
NEUROCORE_ENABLE_CLI_ADAPTER=true
NEUROCORE_ENABLE_HTTP_ADAPTER=true
NEUROCORE_ENABLE_MCP_ADAPTER=true
NEUROCORE_ENABLE_DASHBOARD=true
NEUROCORE_ENABLE_BACKGROUND_SUMMARIZATION=false
NEUROCORE_ENABLE_MULTI_MODEL_CONSENSUS=false
NEUROCORE_CONSENSUS_PROVIDER=none
NEUROCORE_CONSENSUS_MODEL_NAMES=
NEUROCORE_CONSENSUS_BASE_URL=
NEUROCORE_CONSENSUS_API_KEY=
# For full external report generation, prefer:
# NEUROCORE_ENABLE_MULTI_MODEL_CONSENSUS=true
# NEUROCORE_REPORTING_STRATEGY=primary_with_fallback
# NEUROCORE_REPORTING_CONSENSUS_MODE=claim_voting_with_judge
# NEUROCORE_REPORTING_PRIMARY_PROVIDER=deepseek
# NEUROCORE_REPORTING_FALLBACK_PROVIDER=openai
# NEUROCORE_REPORTING_PROVIDER_DEEPSEEK_BASE_URL=https://api.deepseek.com
# NEUROCORE_REPORTING_PROVIDER_DEEPSEEK_API_KEY=REPLACE_WITH_DEEPSEEK_API_KEY
# NEUROCORE_REPORTING_PROVIDER_DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro
# NEUROCORE_REPORTING_PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
# NEUROCORE_REPORTING_PROVIDER_OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
# NEUROCORE_REPORTING_PROVIDER_OPENAI_MODELS=gpt-5-mini
# The bundled localhost mock remains development-only:
# NEUROCORE_CONSENSUS_PROVIDER=openai_compatible
# NEUROCORE_CONSENSUS_MODEL_NAMES=model-a,model-b
# NEUROCORE_CONSENSUS_BASE_URL=http://127.0.0.1:8787/v1
# NEUROCORE_CONSENSUS_API_KEY=local-dev-key
NEUROCORE_PRODUCTION_BACKEND_PROVIDER=supabase
NEUROCORE_PRODUCTION_DATABASE_URL=postgresql://neurocore:replace-me@primary-host.example:5432/neurocore
NEUROCORE_PRODUCTION_SEALED_DATABASE_URL=postgresql://neurocore:replace-me@sealed-host.example:5432/neurocore
NEUROCORE_DEDUP_MERGE_METADATA=true
