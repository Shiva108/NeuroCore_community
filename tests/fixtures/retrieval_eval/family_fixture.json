{
  "name": "family",
  "config": {
    "default_namespace": "project-alpha",
    "allowed_buckets": [
      "research",
      "planning",
      "ops"
    ],
    "default_sensitivity": "standard",
    "max_atomic_tokens": 5,
    "target_chunk_tokens": 5,
    "max_chunk_tokens": 6,
    "chunk_overlap_tokens": 1,
    "semantic_backend": "none",
    "semantic_model_name": "sentence-transformers/all-MiniLM-L6-v2"
  },
  "captures": [
    {
      "alias": "title_target",
      "request": {
        "namespace": "project-alpha",
        "bucket": "research",
        "sensitivity": "standard",
        "content": "critical incident checklist",
        "content_format": "markdown",
        "source_type": "note",
        "title": "Incident Triage Runbook"
      }
    },
    {
      "alias": "alias_target",
      "request": {
        "namespace": "project-alpha",
        "bucket": "planning",
        "sensitivity": "standard",
