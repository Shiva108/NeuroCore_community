{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NeuroCore Ecosystem Contribution Metadata",
  "type": "object",
  "required": [
    "name",
    "category",
    "description",
    "owner",
    "version",
    "requires",
    "tags",
    "difficulty",
    "estimated_time"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "extensions",
        "primitives",
        "recipes",
        "skills",
        "dashboards",
        "integrations",
        "schemas"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "github": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "requires": {
      "type": "object",
      "required": [
        "neurocore"
      ],
      "properties": {
        "neurocore": {
          "type": "boolean",
          "const": true
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "requires_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires_primitives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "estimated_time": {
      "type": "string",
      "minLength": 1
    },
    "curation": {
      "type": "string",
      "enum": [
        "open",
        "curated"
      ]
    },
    "created": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
